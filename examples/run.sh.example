#!/bin/bash
# Copy to run.sh at the top of the checkout or release, beside rust/ (run.sh is gitignored),
# and see README "Setup" for each step. It runs from its own directory and keeps rex.db there.
#
# Keys, if any, go in rex.env beside run.sh (gitignored, as is run.sh). Under systemd,
# EnvironmentFile= can load the same file instead.
#
# Sources register themselves and push their items (docs/feed-api.md): zurg needs only
# rex_url in its config.yml. Nothing about a source is set here.
#
# On a host that runs Plex too, use --port 32500.
#
# --announce-url is only for an extra HTTPS address of your own (with --tls-cert/--tls-key
# when rex serves that name itself): once claimed, rex announces its LAN address and its
# rex-direct address by itself.
# Not a Cloudflare tunnel: docs/setup.md says why.
set -e
cd "$(dirname "$0")"
[ -f rex.env ] && { set -a; . ./rex.env; set +a; }
exec rust/target/release/rex
