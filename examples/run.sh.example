#!/bin/bash
# Copy to run.sh at the top of the checkout or release, beside rust/ (run.sh is gitignored),
# fill in the values, and see README "Setup" for each step. It runs from its own directory.
#
# Keys come from rex.env beside run.sh (mode 600; gitignored, as is run.sh):
# TMDB_KEY names what is pushed and powers Fix Match. PLEX_TOKEN (the owner's account token)
# is optional: a claimed server asks Plex's metadata agent and plex.tv with its own token, and
# only an unclaimed one that should still match with Plex's agent needs it.
# REX_METADATA_URL (+REX_METADATA_KEY) reads TMDB through a metadata provider first, such as
# DMM for its sponsors (docs/metadata-api.md).
# Under systemd, EnvironmentFile= can load the same file instead.
#
# Sources register themselves and push their items (docs/feed-api.md): zurg needs only
# rex_url in its config.yml. Nothing about a source is set here.
#
# The first start seeds rex.db, named by --friendly-name, its libraries under --zurg-mount;
# to name more directories, seed it yourself first: rust/target/release/rex catalog --seed
# --out rex.db (--movies/--shows). The server keeps its state (watch state, edits, lists,
# history, prefs, the sources' registrations) in the same file.
#
# On --port 32400 rex answers Plex's LAN discovery (GDM) on udp/32410 and udp/32414; on a
# host that runs Plex too, use another port and --gdm off.
#
# --announce-url: an unclaimed server announces nothing until it is claimed, then at once.
# With PLEX_TOKEN set it would announce with that token before the claim, which can make the
# claim fail (docs/setup.md step 6), so it is left off then until claim_state.json exists.
# The HTTPS address needs --tls-cert/--tls-key here (a PKCS#8 or RSA key). Not a Cloudflare
# tunnel: docs/setup.md step 7 says why.
set -e
cd "$(dirname "$0")"
[ -f rex.env ] && { set -a; . ./rex.env; set +a; }
ANNOUNCE=()
if [ -f claim_state.json ] || [ -z "${PLEX_TOKEN:-}" ]; then
  ANNOUNCE=(--announce-url "https://rex.example.com:32400,http://192.168.1.10:32400")
fi
exec rust/target/release/rex \
  --catalog rex.db \
  --friendly-name myrex \
  --zurg-mount /mnt/zurg \
  --port 32400 \
  --owner-username your-plex-username \
  --owner-email you@example.com \
  "${ANNOUNCE[@]}"
