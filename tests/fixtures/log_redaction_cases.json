    {"line": "ARTWORK fetch http://127.0.0.1:19920/library/metadata/1007/thumb/1?X-Plex-Token=REPLICATE859a", "secrets": ["REPLICATE859a"], "kept": ["ARTWORK fetch http://127.0.0.1:19920/library/metadata/1007/thumb/1?X-Plex-Token="]},
    {"line": "/myplex/claim?token=claim-REPLICATE859b", "secrets": ["REPLICATE859b"], "kept": ["/myplex/claim?token="]},
