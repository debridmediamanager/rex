    {"line": "ARTWORK fetch http://user:REPLICATE859p@127.0.0.1:9/poster.jpg", "secrets": ["REPLICATE859p"], "kept": ["ARTWORK fetch http://", "@127.0.0.1:9/poster.jpg"]},
    {"line": "\"GET /photo/:/transcode?width=240&url=http%3A%2F%2Fuser%3AREPLICATE859q%40127.0.0.1%3A9%2Fposter.jpg HTTP/1.1\" 502", "secrets": ["REPLICATE859q"], "kept": ["url=http%3A%2F%2F", "127.0.0.1%3A9%2Fposter.jpg HTTP/1.1\" 502"]},
