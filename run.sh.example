#!/bin/zsh
# Copy to run.sh (gitignored) and fill in the credential.
#
# RD_TOKEN is the Real-Debrid API key whose account owns the /d/ links in
# catalog.json. Those links are account-scoped: another account answers
# 404 unavailable_file for them, which surfaces as HTTP 502 on every part read.
set -e
cd "$(dirname "$0")"
export RD_TOKEN=...
#
# On --port 32400 plexsim answers Plex's LAN discovery protocol (GDM) on udp/32410
# and udp/32414 by default, which is what a real PMS does and what lets an official
# client on the same network find it without plex.tv. `--gdm off` turns it off.
#
# The server keeps watch state, edits, playlists, collections, history, preferences,
# uploads and the device/statistics tables across restarts in a SQLite database,
# plexsim.db beside the catalog (gitignored), by default, writing only what changed;
# --state FILE moves it, and with --no-state a restart reloads the catalog as it is on
# disk. An older state.json beside the catalog is imported into it once and kept as
# state.json.migrated. The Python server keeps a pickle instead, so a state file does
# not carry over from one server to the other.
#
# The catalog can live in a database too, and the state then shares that one file:
#   ./build_catalog.py --convert catalog.json --out plexsim.db
# and pass --catalog plexsim.db below.
#
# Build the server first: cargo build --release --manifest-path rust/Cargo.toml
# The Python server (the measured oracle) still runs with: python3 server.py <flags>
exec rust/target/release/plexsim \
  --port 32400 \
  --part-mode proxy \
  --assert-claimed \
  --verbose
