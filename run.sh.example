#!/bin/bash
# Copy to run.sh (gitignored), fill in the values, and see README "Setup" for each step.
#
# Keys come from rex.env beside this script (mode 600; gitignored, as are run.sh and
# sources.json): TMDB_KEY names what is pushed and powers Fix Match,
# PLEX_TOKEN (the owner's account token) feeds Plex's metadata agent and the announce.
# Under systemd, EnvironmentFile= can load the same file instead.
#
# sources.json names every source that pushes items and serves their bytes
# (docs/feed-api.md). A single zurg can do without it: ZURG_URL (+ZURG_USER and
# ZURG_PASSWORD), REX_FEED_TOKEN and --zurg-mount in the environment define the source
# "zurg".
#
# The catalog is ./build_catalog.py --seed --mount <each source's mount> --out rex.db;
# the server keeps its state (watch state, edits, lists, history, prefs) in the same file.
#
# On --port 32400 rex answers Plex's LAN discovery (GDM) on udp/32410 and udp/32414; on a
# host that runs Plex too, use another port and --gdm off.
#
# --announce-url is added once the server is claimed (claim_state.json beside the
# catalog): claim it first, without it. The HTTPS address needs --tls-cert/--tls-key here
# (a PKCS#8 or RSA key) or a named tunnel in front (cloudflared.example.yml).
set -e
cd "$(dirname "$0")"
[ -f rex.env ] && { set -a; . ./rex.env; set +a; }
ANNOUNCE=()
[ -f claim_state.json ] && ANNOUNCE=(--announce-url "https://rex.example.com:32400,http://192.168.1.10:32400")
exec rust/target/release/rex \
  --catalog rex.db \
  --sources sources.json \
  --port 32400 \
  --owner-username your-plex-username \
  --owner-email you@example.com \
  "${ANNOUNCE[@]}"
