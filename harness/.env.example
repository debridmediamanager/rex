# Copy to .env and fill in from the reference server once it is claimed:
#   curl -s http://127.0.0.1:32400/identity        -> machineIdentifier
#   the certificateIdentifier in its plex.tv announce, or the hash in its
#   https://<ip-with-dashes>.<hash>.plex.direct connection URI
#
# Neither is a secret; both are per-install, which is why they are not committed.
PLEXLAB_MACHINE_ID=
PLEXLAB_CERT_HASH=

# Optional: extra hostnames the proxy should refuse outright, comma separated.
# Every *other* server on the same plex.tv account is already filtered out of
# the resource list, so this is only for non-plex.direct hosts.
PLEXLAB_BLOCK_HOSTS=

TZ=Europe/Amsterdam
